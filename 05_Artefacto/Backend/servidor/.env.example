# Copiar para .env e preencher. O .env não vai para o GitHub.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=elotask

# "dev" também aceita entrar só com o email (testes). Em produção: "jwt"
AUTH_MODE=dev
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Cifra da sinalização das chamadas. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAMADAS_CHAVE=

IA_SERVICE_URL=http://127.0.0.1:8000
# Tem de ser igual ao IA_API_KEY do ia_service
IA_SERVICE_API_KEY=
