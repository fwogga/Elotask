# Copiar para .env e preencher. O .env não vai para o GitHub.
# Palavra-passe do root do MySQL do Docker
DB_PASSWORD=escolhe-uma-palavra-passe
# Utilizador "elotask" (o mesmo no MAMP e no Docker) que o servidor do Docker usa
DB_APP_PASSWORD=outra-palavra-passe
# Utilizador "replicacao" (o mesmo no MAMP e no Docker)
REPLICACAO_PASSWORD=mais-uma-palavra-passe
# Iguais aos do servidor/.env, para os tokens e as chamadas servirem nos dois servidores
JWT_SECRET=
CHAMADAS_CHAVE=
# Igual ao IA_SERVICE_API_KEY do servidor/.env
IA_API_KEY=
