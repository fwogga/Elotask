# Copiar para .env e preencher. O .env não vai para o GitHub.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=
DB_NAME=elotask

# Tem de ser IGUAL ao JWT_SECRET do backend_comunicacao (assim o mesmo login serve os dois)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Serviço Python que gera as escalas de turnos (ia_turnos)
IA_API_URL=http://127.0.0.1:8001
