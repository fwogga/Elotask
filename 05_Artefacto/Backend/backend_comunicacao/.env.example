# Copiar para .env e preencher. O .env não vai para o GitHub.
PORT=3002

DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=
DB_NAME=elotask

# "dev" aceita o cabeçalho x-user-id e a entrada só com email (testes). Em produção: "jwt"
AUTH_MODE=dev
# Tem de ser IGUAL ao JWT_SECRET do backend_principal
JWT_SECRET=

# Gerar com: node scripts/gerar-chave.js
CHAMADAS_CHAVE=

IA_SERVICE_URL=http://127.0.0.1:8000
# Tem de ser igual ao IA_API_KEY do ia_service
IA_SERVICE_API_KEY=
